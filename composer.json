{
  "name": "torann/mediasort",
  "description": "Attachment manager for Laravel.",
  "keywords": [
    "upload",
    "media",
    "filesystem",
    "cloud storage",
    "aws",
    "attachments",
    "file",
    "paperclip"
  ],
  "license": "BSD-2-Clause",
  "authors": [
    {
      "name": "Daniel Stainback",
      "email": "torann@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/container": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/console": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/filesystem": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/view": "^9.0|^10.0|^11.0|^12.0",
    "imagine/imagine": "^1.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "mockery/mockery": "^1.4.4",
    "phpstan/phpstan": "^1.6",
    "squizlabs/php_codesniffer": "^3.6"
  },
  "suggest": {
    "ralouphie/mimey": "Simplified MIME type lookup"
  },
  "autoload": {
    "psr-4": {
      "Torann\\MediaSort\\": "src/"
    }
  }
}
